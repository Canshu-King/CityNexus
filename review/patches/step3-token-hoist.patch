-/* Bind the V8 shell to the Apple palette + system font without touching markup:
-   existing components consume --v8-* vars, so remapping them re-skins the app. */
-.v8-product-shell {
+/* Bind the V8 palette to the Apple tokens at :root rather than on the shell.
+   Existing components consume --v8-*, so rebinding them re-skins the app; doing it
+   on :root additionally reaches the one screen that is returned *before*
+   .v8-product-shell exists — JourneyTrialSetup (V8Experience.tsx:818) — which until
+   now got neither the Apple palette nor the dark theme.  styles.css declares the
+   literal defaults on :root too, so this block still wins by load order. */
+:root {
   --v8-canvas: var(--cn-canvas);
   --v8-panel: var(--cn-surface);
   --v8-ink: var(--cn-ink);
@@ -125,6 +129,19 @@
   --v8-green: var(--cn-success);
   --v8-amber: var(--cn-warning);
   --v8-coral: var(--cn-danger);
+  /* Two tokens 18 declarations referenced but nobody ever defined, so every one of
+     them silently took its fallback: --v8-accent resolved to teal #0f766e in 14
+     places (making the create-trip primary button a different colour from every
+     other primary button in the app) and --v8-surface resolved to #0b1f24 in one
+     place and #fff in two others — one token, three intents.  Accent and card
+     surface get real values here; the near-black site was never a surface at all,
+     it wanted the page canvas behind a fading sticky bar, so that declaration now
+     reads --v8-canvas directly in styles.css. */
+  --v8-accent: var(--cn-accent);
+  --v8-surface: var(--cn-surface);
+}
+
+.v8-product-shell {
   font-family: var(--cn-font);
   -webkit-font-smoothing: antialiased;
   text-rendering: optimizeLegibility;
