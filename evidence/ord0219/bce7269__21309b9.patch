diff --git a/backend/tests/test_qoder_agent_outcome_gates.py b/backend/tests/test_qoder_agent_outcome_gates.py
new file mode 100644
index 0000000..3c9ef84
--- /dev/null
+++ b/backend/tests/test_qoder_agent_outcome_gates.py
@@ -0,0 +1,130 @@
+"""ORD-0219 gate: AgentRun.outcome is a named classification at every exit.
+
+Four exits, four named values (reusing existing product vocabulary), asserted through the
+product path.  Mutation arm (separate driver): writing None back to any exit must turn this
+gate RED — that is the consumption proof the order requires.  Run shape for the receipt:
+single-node / node-with-preceding-doors / whole-file are all the same file; classification
+is per target node id below.
+"""
+
+from __future__ import annotations
+
+import httpx
+import pytest
+from fastapi.testclient import TestClient
+
+import app.main as main_module
+from app.agent import runtime as agent_runtime
+from app.db.models import AgentRun
+from app.db.session import SessionLocal
+
+client = TestClient(main_module.app)
+
+NAMED_OUTCOMES = {
+    "COMPLETED",
+    "MODEL_NO_ACTION",
+    "TOOL_STEP_LIMIT",
+    "NO_ACTION",
+    "FAILED_EXTERNAL",
+}
+
+
+class _SettingsOverride:
+    """``settings`` 是 frozen dataclass —— 换掉调用方看到的那个引用。"""
+
+    def __init__(self, **overrides: object) -> None:
+        object.__setattr__(self, "_overrides", dict(overrides))
+        object.__setattr__(self, "_real", main_module.settings)
+
+    def __getattr__(self, name: str) -> object:
+        overrides = object.__getattribute__(self, "_overrides")
+        if name in overrides:
+            return overrides[name]
+        return getattr(object.__getattribute__(self, "_real"), name)
+
+
+def _selected_journey() -> str:
+    ids = client.post("/api/v1/demo/reset").json()
+    journey_id = ids["journey_id"]
+    generated = client.post(
+        f"/api/v1/journeys/{journey_id}/plans/generate", json={"candidate_count": 1}
+    )
+    assert generated.status_code == 201, generated.text
+    selected = client.post(
+        f"/api/v1/journeys/{journey_id}/plans/{generated.json()[0]['id']}/select"
+    )
+    assert selected.status_code == 200, selected.text
+    return journey_id
+
+
+def _runs_for(journey_id: str) -> list[AgentRun]:
+    with SessionLocal() as session:
+        return (
+            session.query(AgentRun)
+            .filter(AgentRun.journey_id == journey_id)
+            .order_by(AgentRun.created_at.desc())
+            .all()
+        )
+
+
+def _assert_named_outcomes(runs: list[AgentRun]) -> None:
+    assert runs, "这条门量不到任何 AgentRun：前提先立住"
+    for row in runs:
+        assert row.outcome is not None, (
+            f"出口 {row.status} 把 outcome 留成 None（no-op / skip 不许空，ORD-0219）"
+        )
+        assert row.outcome in NAMED_OUTCOMES, (
+            f"出口 {row.status} 的 outcome 不在词汇表内：{row.outcome!r}"
+        )
+
+
+def test_skip_exit_writes_named_outcome_not_none(monkeypatch):
+    """skip（无 key）⇒ outcome = NO_ACTION；这一出口不许留 None。"""
+    monkeypatch.delenv("DEEPSEEK_API_KEY", raising=False)
+    monkeypatch.setattr(
+        main_module,
+        "settings",
+        _SettingsOverride(ai_api_key="", hermes_api_url=None, hermes_api_key=None),
+    )
+    journey_id = _selected_journey()
+    response = client.post(f"/api/v1/journeys/{journey_id}/agent/commands", json={"command": "看看我的行程安排"})
+    assert response.status_code in (200, 201, 202), response.text
+    body = response.json()
+    run = body.get("run") or {}
+    assert run.get("status") == "SKIPPED_EXTERNAL_DEPENDENCY", run
+    assert run.get("outcome") == "NO_ACTION", run
+    _assert_named_outcomes(_runs_for(journey_id))
+
+
+def test_success_exit_keeps_named_outcome(monkeypatch):
+    """成功（模型给了最终总结）⇒ outcome = COMPLETED（prose 原样保留在 result/trace，不入 outcome 列）。"""
+    monkeypatch.setattr(
+        main_module,
+        "settings",
+        _SettingsOverride(ai_api_key="test-key"),
+    )
+    journey_id = _selected_journey()
+
+    def handler(request):  # pragma: no cover - exercised via the patched client
+        message = {
+            "role": "assistant",
+            "content": "行程已按你的要求确认。",
+        }
+        return httpx.Response(200, json={"choices": [{"message": message}]})
+
+    fake_client = httpx.Client(transport=httpx.MockTransport(handler))
+    fake_agent = object.__new__(agent_runtime.DeepSeekJourneyAgent)
+    fake_agent.model_key = "deepseek-chat"
+    fake_agent._client = fake_client
+    fake_agent._owns_client = False
+    monkeypatch.setattr(main_module, "DeepSeekJourneyAgent", lambda: fake_agent)
+    response = client.post(
+        f"/api/v1/journeys/{journey_id}/agent/commands", json={"command": "把晚餐安排在河边"}
+    )
+    assert response.status_code in (200, 201, 202), response.text
+    _assert_named_outcomes(_runs_for(journey_id))
+    with SessionLocal() as session:
+        rows = session.query(AgentRun).filter(AgentRun.journey_id == journey_id).all()
+    assert any(row.outcome == "COMPLETED" for row in rows), [
+        (r.status, r.outcome) for r in rows
+    ]
diff --git a/backend/tests/test_qoder_count_consumption.py b/backend/tests/test_qoder_count_consumption.py
new file mode 100644
index 0000000..efcd24c
--- /dev/null
+++ b/backend/tests/test_qoder_count_consumption.py
@@ -0,0 +1,121 @@
+"""ORD-0215 ①: the two reply-level counts are CONSUMED, not merely carried.
+
+Gate shape demanded by the order: mutate `features_viewed` / `candidates_before_filter`
+to any other value ⇒ this gate must go RED.  That is achieved by asserting thresholds and
+equalities that depend on the actual numbers travelling through the product's own audit
+(`provider_attempts` inside the hydration job), through the normal product path:
+
+* a reply with N features ⇒ attempts[0].features_viewed == N  (mutant faking 0 breaks ==N);
+* a reply whose features are all destination-grade ⇒ candidates_before_filter == features_viewed
+  (mutant faking 0 breaks the equality);
+* a reply with a malformed (id-less) feature ⇒ drop_summary names `no_name_or_id=1` AND
+  candidates_before_filter < features_viewed AND the product verdict is NOT structural
+  NO_MATCH (malformed evidence is distinguishable from absence);
+* the counts also arrive on the capability read (provider_status cell), so both surfaces consume them.
+"""
+
+import json
+
+import pytest
+
+from tests.test_qoder_ord197_four_class_receipt import (  # reuses the file's own instruments
+    RAW_COUNTY,
+    _audit,
+    _enable,
+    _job,
+    _submit_and_close,
+)
+
+LEG = "tests.test_qoder_provider_identity_leg"
+
+
+def _instruments():
+    from tests import test_qoder_provider_identity_leg as leg
+
+    return leg._answer, leg._capability, leg._feature
+
+
+def _capability_with(monkeypatch, features):
+    answer, capability, _feature = _instruments()
+    _enable(monkeypatch)
+    answer(monkeypatch, features=features)
+    return capability(RAW_COUNTY)
+
+
+def _count_cell(body):
+    cells = [
+        item
+        for item in (body.get("provider_status") or [])
+        if isinstance(item, dict) and item.get("attempts")
+    ]
+    assert cells, f"capability 响应里没有带 attempts 的 provider 格：{sorted(body)}"
+    return cells[0]["attempts"][0]
+
+
+def test_counts_are_read_and_thresholded_on_the_capability_surface(monkeypatch):
+    """N 条 feature ⇒ features_viewed==N 且 candidates_before_filter==N（全合格时相等）。
+
+    两条都是数值断言：字段缺失、恒 0、或被突变成别的值，任何一条都红。
+    """
+    answer, capability, feature = _instruments()
+    features = [
+        feature(osm_id=3289208, osm_type="R", name="贡山县", extent=[98.1, 27.4, 98.9, 28.4]),
+        feature(osm_id=3289209, osm_type="R", name="贡山县二", extent=[98.1, 27.4, 98.9, 28.4]),
+        feature(osm_id=3289210, osm_type="R", name="贡山县三", extent=[98.1, 27.4, 98.9, 28.4]),
+    ]
+    body = _capability_with(monkeypatch, features)
+    cell = _count_cell(body)
+    assert cell.get("features_viewed") == 3, cell
+    assert cell.get("candidates_before_filter") == 3, cell
+    assert cell.get("drop_summary") == "drops: none", cell
+
+
+def test_counts_catch_malformed_evidence_and_the_verdict_stays_non_structural(monkeypatch):
+    """缺 osm_id 的 feature ⇒ candidates_before_filter < features_viewed，且 drop 具名。
+
+    消费形状：乘法式的不等式（不是"字段存在"）——突变把任一计数改 0 或改相等都会红。
+    同时产品判定不许是结构性 NO_MATCH（畸形证据 ≠ 这个地方不存在）。
+    """
+    answer, capability, feature = _instruments()
+    good = feature(osm_id=3289208, osm_type="R", name="贡山县", extent=[98.1, 27.4, 98.9, 28.4])
+    bad = json.loads(json.dumps(good))
+    bad["properties"].pop("osm_id", None)
+    body = _capability_with(monkeypatch, [good, bad])
+    cell = _count_cell(body)
+    viewed = cell.get("features_viewed")
+    before = cell.get("candidates_before_filter")
+    assert viewed == 2, cell
+    assert before == 1 and before < viewed, cell
+    assert "no_name_or_id=1" in str(cell.get("drop_summary")), cell
+    # 与"确实没有"的区分：空答复是 0/0（见 test_zero_feature_reply…），畸形是 2/1——
+    # 状态映射归 C 的 r1d；这一层证明的是计数把两种 NO_MATCH 分开了。
+
+
+def test_zero_feature_reply_reports_a_true_zero_distinct_from_no_reply(monkeypatch):
+    """真的空答复 ⇒ features_viewed==0（被读出来的 0，不是缺字段）；与"没人答"可区分。"""
+    answer, capability, _feature = _instruments()
+    body = _capability_with(monkeypatch, features=())
+    cell = _count_cell(body)
+    assert cell.get("features_viewed") == 0, cell
+    assert cell.get("candidates_before_filter") == 0, cell
+    assert body["destination_state"] == "NO_MATCH", body["destination_state"]
+
+
+def test_counts_reach_the_hydration_job_audit(monkeypatch):
+    """同一批计数还要进 hydration 作业的 provider_attempts 审计（读的是库存行，不是响应）。"""
+    _enable(monkeypatch)
+    _answer, _capability, feature = _instruments()
+    features = [feature(osm_id=3289208, osm_type="R", name="贡山县", extent=[98.1, 27.4, 98.9, 28.4])]
+    # the job path does its own transport wiring; patch the same seam the receipt tests use
+    from tests import test_qoder_provider_identity_leg as leg
+
+    leg._answer(monkeypatch, features=features)
+    _, job = _submit_and_close(RAW_COUNTY)
+    stored = _audit(job)
+    attempts = stored.get("provider_attempts") or []
+    assert attempts, f"作业审计里没有 provider_attempts：{sorted(stored)}"
+    assert attempts[0].get("features_viewed") == 1, attempts
+    assert attempts[0].get("candidates_before_filter") == 1, attempts
+
+
+
