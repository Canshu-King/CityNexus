 frozen_at: "2026-09-22T16:40:22+08"
 
+# 结案三档（源审计 5775293071 ① / 仲裁 20:01「只是给 10/10 绿改名，不产生新证据」）：
+# 这一节**不新造验收条件**，只把已有三样既有证据写成显式门槛：
+#   既有第 5 条（10 全绿） + 既有第 2 条（10 个独立进程） + 既有第 6b 条（自证文本）
+#   + 仲裁 15:58 已给的**反向要求**（破坏保护点必须重新出 RED 或打断 streak）
+closure_ladder:
+  NOT_MET: "streak 未达成（STREAK_NOT_MET / 任何 HARNESS_INVALID / RECEIPT_INCOMPLETE）"
+  STREAK_GREEN: "第 5 条达成，但反向突变证据缺失或不是结案级 ⇒ 只到这一档，不签 CLOSED"
+  CLOSED: "STREAK_GREEN 之外，另有 reverse_mutation_result ∈ [KILLED, STREAK_BROKEN]"
+reverse_mutation:
+  required_for: acceptance            # 机制模式不要求（靶子可以一直红）
+  closure_grade_results: [KILLED, STREAK_BROKEN]
+  rejected_results: [SURVIVED, NOT_MEASURED]
+  field: reverse_mutation_result      # 词表外的值本身 = 收据缺陷（checks.reverse_mutation_value_valid）
+
+# 第 9 条的可机器判形状（源审计 ③）：形制不能只是收据里一个自由文本字段。
+run_shape_argv:
+  single-node: [-m, pytest, "<恰好一条 nodeid>", --tb=short, --import-mode=importlib]
+  node-with-preceding-doors-in-one-process: [-m, pytest, "<≥2 条 nodeid，同进程>", --tb=short, --import-mode=importlib]
+  whole-file: [-m, pytest, "<一个文件路径>", --tb=short, --import-mode=importlib]
+  forbidden_in_argv: [-rA, "-p"]      # -rA 把逐 run 报告混进 stdout；-p 是改跑法不是记读数
+  streams: stdout 与 stderr 分开解码并各记 codec（拼成一坨 ⇒ 形制证据不成立）
+  judged_by: verify_run_shape()；不过则 streak_verdict 直接 HARNESS_INVALID_run_shape_unverified
+
+# 文本读取权威（源审计 ①：三处 reader 都栽在"解码失败被当成没命中"）
+reader_chain:
+  rule: 先读完整字节 → 显式解码；顺序 UTF-8(严格) → gb18030(严格) → UTF-8/surrogateescape → gb18030/surrogateescape → latin-1/surrogateescape
+  never: errors="replace"             # U+FFFD 会把一行收据伪装成"不存在"，resolved= 路径就这样丢
+  reversible: surrogateescape 必须能字节回映（测试里用真坏字节验证）
+  receipt_field: child_decoder        # 记 stdout=/stderr= 各用了哪档 codec
+  path_validation: resolved_path_problems() —— 绝对、像 .db、无解码受损痕迹、且**大小写归一后**不撞被保护的库
+  protected_paths: Windows 大小写不敏感 ⇒ 比较走 normcase+casefold（`_LIVE.DB` 也是 `_live.db`）
+
 clauses:
   1: exact same product/test SHA;
   2: 10 CONSECUTIVE independent processes;
