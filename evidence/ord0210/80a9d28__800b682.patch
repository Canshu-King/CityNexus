+    for ch in blob:
+        if SURROGATE_RANGE[0] <= ord(ch) <= SURROGATE_RANGE[1]:
+            return f"含 surrogateescape 的孤立代理 {hex(ord(ch))}（原字节还在，但这条值不是真字符）"
+    return ""
