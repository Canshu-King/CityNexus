@@ -501,6 +501,53 @@ def node_outcome_from_exit(
 # ======================================================================================
 # 第 10 条：给目标节点定性（范围 = exact SHA + target node id + run shape）
 # ======================================================================================
+def merge_target_observations(batches: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    """把同一个 (SHA, target node id, run shape) 三元组下的**多批**读数并成一份定性输入。
+
+    仲裁 5779720219 的口径纠正（我上一版写反了）：**定性的 scope 只有那三元组**，
+    "第几批"只是 provenance。所以同一三元组下 A 批 0/10 全红、B 批 2/10 有绿 ⇒
+    合并后必须是 `FLIP_WITHOUT_SHARED_STATE(<shape>)`，**不许**两批各签一个
+    `STABLE_RED` 与 `FLIP` 互相打脸。三元组不一致的批次不许混批 ⇒ 直接 UNCLASSIFIED 并点名差在哪。
+
+    入参每批：`{sha, target_nodeid, run_shape, node_outcomes, resolved_db_paths, batch?}`
+    返回：`{sha, target_nodeid, run_shape, node_outcomes, resolved_db_paths, provenance, problems}`
+    —— 直接喂给 `classify_target_node(**merged)` 就行。
+    """
+
+    items = list(batches)
+    if not items:
+        return {"sha": "", "target_nodeid": "", "run_shape": "", "node_outcomes": [],
+                "resolved_db_paths": [], "provenance": [],
+                "problems": ["没有任何批次可合并：没有分母"]}
+    keys = {"sha": "exact SHA", "target_nodeid": "target node id", "run_shape": "run shape"}
+    problems: list[str] = []
+    head = items[0]
+    for idx, batch in enumerate(items[1:], start=2):
+        for field, label in keys.items():
+            if str(batch.get(field) or "") != str(head.get(field) or ""):
+                problems.append(
+                    f"第 {idx} 批的 {label} 与第 1 批不等（{batch.get(field)!r} ≠ "
+                    f"{head.get(field)!r}）⇒ 不同 scope 不许并成一次定性")
+    outcomes: list[str] = []
+    paths: list[Any] = []
+    provenance: list[dict[str, Any]] = []
+    for batch in items:
+        got = [str(o) for o in (batch.get("node_outcomes") or [])]
+        outcomes.extend(got)
+        paths.extend(list(batch.get("resolved_db_paths") or []))
+        provenance.append({
+            "batch": batch.get("batch") or f"batch-{len(provenance) + 1}",
+            "sha": str(batch.get("sha") or ""), "target_nodeid": str(batch.get("target_nodeid") or ""),
+            "run_shape": str(batch.get("run_shape") or ""), "runs": len(got),
+            "green": sum(1 for o in got if o == "GREEN"),
+            "red": sum(1 for o in got if o == "RED"),
+            "not_observed": sum(1 for o in got if o not in ("GREEN", "RED")),
+        })
+    return {"sha": str(head.get("sha") or ""), "target_nodeid": str(head.get("target_nodeid") or ""),
+            "run_shape": str(head.get("run_shape") or ""), "node_outcomes": outcomes,
+            "resolved_db_paths": paths, "provenance": provenance, "problems": problems}
+
+
 def classify_target_node(
     *,
     sha: str,
