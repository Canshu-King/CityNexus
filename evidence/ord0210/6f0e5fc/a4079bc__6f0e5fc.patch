+def test_4e_batches_of_one_triple_merge_into_one_verdict():
+    """仲裁 5779720219 的口径纠正：**scope = (SHA, node, shape) 三元组；"第几批"只是 provenance。**
+
+    我上一版把它写反了（说"定性在批次内成立、引用必须带批次"）。真正要防的是：
+    同一三元组的 A 批全红、B 批偶绿，被两批各签一个 `STABLE_RED` 与 `FLIP` 互相打脸。
+    """
+
+    def batch(label, greens, sha=SHA_MERGED, node=TARGET_NODEID, shape=SINGLE_NODE):
+        outcomes = ["GREEN"] * greens + ["RED"] * (10 - greens)
+        return {"batch": label, "sha": sha, "target_nodeid": node, "run_shape": shape,
+                "node_outcomes": outcomes,
+                "resolved_db_paths": [f"C:/tmp/cnx_{label}_{i}/suite.db" for i in range(10)]}
+
+    merged = merge_target_observations([batch("A", 0), batch("B", 2)])
+    assert merged["problems"] == [], f"期望两批同三元组可合并；实际 {merged['problems']}"
+    assert len(merged["node_outcomes"]) == 20 and len(merged["resolved_db_paths"]) == 20, (
+        f"期望合并后分母是 20 run；实际 outcomes={len(merged['node_outcomes'])} "
+        f"paths={len(merged['resolved_db_paths'])}")
+    merged_cls = classify_target_node(**{k: v for k, v in merged.items()
+                                        if k in ("sha", "target_nodeid", "run_shape",
+                                                 "node_outcomes", "resolved_db_paths")})
+    assert merged_cls["named_shape"] == "FLIP_WITHOUT_SHARED_STATE(single-node)", (
+        f"期望：两批合并后只能有一个结论 FLIP（目标节点自己两种结果都有过）；"
+        f"实际 {merged_cls['named_shape']} —— {merged_cls['reason']}")
+    assert merged_cls["green"] == 2 and merged_cls["red"] == 18, (
+        f"期望合并计数 2 绿 / 18 红；实际 {merged_cls['green']}/{merged_cls['red']}")
+    assert [p["batch"] for p in merged["provenance"]] == ["A", "B"] and \
+        [p["green"] for p in merged["provenance"]] == [0, 2], (
+        f"期望 provenance 逐批保留（谁看了都知道 B 批才有绿）；实际 {merged['provenance']}")
+
+    only_keys = ("sha", "target_nodeid", "run_shape", "node_outcomes", "resolved_db_paths")
+    a_alone = classify_target_node(**{k: v for k, v in merged.items() if k in only_keys}
+                                   | {"node_outcomes": ["RED"] * 10,
+                                      "resolved_db_paths": batch("A", 0)["resolved_db_paths"]})
+    assert a_alone["classification"] == "STABLE_RED", (
+        "（内部对照）单独一批仍可判 STABLE_RED，但它在合并口径下不具权威性")
+    assert a_alone["sample_note"] or merged_cls["classification"] == "FLIP_WITHOUT_SHARED_STATE", (
+        "期望：单批 STABLE 与合并 FLIP 并存时，以合并结论为准（尺不许同时供两个权威标签）")
+
+    for label, kwargs in (
+        ("sha 不同", {"sha": "another_sha"}),
+        ("nodeid 不同", {"nodeids": None, "target_nodeid": "tests/other.py::g9"}),
+        ("形制不同", {"run_shape": WHOLE_FILE}),
+    ):
+        other = batch("B", 2)
+        other.update(kwargs)
+        mixed = merge_target_observations([batch("A", 0), other])
+        assert mixed["problems"], f"期望：{label} 的两批不许并成一次定性；实际放行了"
