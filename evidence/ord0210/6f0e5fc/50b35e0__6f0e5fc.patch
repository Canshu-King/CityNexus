+        assert "_live.db" in str(caught.value), (
+            f"期望拒绝信息里点名被保护的库；实际 {str(caught.value)[:140]!r}（输入 {shape}）")
+    bad = resolved_path_problems("C:\\Users\\\ufffdan\\Temp\\cnx_pytest_x\\suite.db")
+    assert any("解码受损" in p for p in bad), (
