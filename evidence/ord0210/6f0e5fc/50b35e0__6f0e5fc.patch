+        node_outcomes=outcomes, resolved_db_paths=[r["resolved_absolute_db_path"] for r in rows])
+    receipt["classification"]["named_shape"] = (
+        f"{receipt['classification']['classification']}{shape_suffix}")
+    receipt["runs"] = rows
+    receipt["mode"] = "mechanism"
