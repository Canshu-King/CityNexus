# --------------------------------------------------------------------------- arm 3: mutants
def blob(path):
    r = subprocess.run(["git", "-C", "D:/moodle/CityNexus", "hash-object", "-w",
                        path.replace("\\", "/")], capture_output=True, text=True,
                       encoding="utf-8", errors="replace", timeout=120)
    sha = (r.stdout or "").strip()
    assert re.fullmatch(r"[0-9a-f]{40}", sha), (path, r.stdout, r.stderr)
    return sha


MUTANTS = [
    ("M1_union_fallback",
     "  const s = CONTRACT.enums[field];\n  return (s && s.length) ? s : null;",
     "  const s = CONTRACT.enums[field];\n  if (s && s.length) return s;\n"
     "  const all = [];\n  for (const k of Object.keys(CONTRACT.enums)) all.push.apply(all, "
     "CONTRACT.enums[k]);\n  return all.length ? all : null;",
     "B7_anchor_names_error_code_and_B9_set_for_another_field",
     "an unrelated enum vouches for a field the contract never declared: a false green"),
    ("M2_enum_key_owns_the_set",
     "    if (m) {\n      const ind = m[1].length, key = m[2], rest = m[3];",
     "    if (m) {\n      const ind = m[1].length, key = m[2] === 'enum' ? 'enum_owner' : m[2], "
     "rest = m[3];",
     "block_form_goes_green",
     "the first parse of this lineage: a block-form set attributed to the wrong name"),
    ("M3_silent_contract_is_pass",
     "  const set = contractSetFor(field);\n  if (!set) {",
     "  const set = contractSetFor(field) || ['NOT_A_REAL_CODE', 'INTERNAL_ERROR'];\n  if (!set) {",
     "before_tip_contract_is_red",
     "a contract that names nothing becomes permission by silence"),
    ("M4_ignore_the_chain",
     "  const bad = seen.filter(function (v) { return set.indexOf(v) < 0; });",
     "  const bad = [];",
     "B2_invented_code_stays_red",
     "the client's own invented token is never compared against the set"),
    ("M5_refused_cell_may_fold",
     "      const context = (!contractBlocked && h.sink === 'jsx-text') ? foldContext(h._node) : null;",
     "      const context = h.sink === 'jsx-text' ? foldContext(h._node) : null;",
     "B2_or_B3_refused_cell_not_folded",
     "the same data-cnx-field that performs the lookup then vouches for the disclosure around it"),
    ("M6_exempt_by_field_name",
     "      const codeField = cnxFieldNamedOnCell(h._node);",
     "      const codeField = null;",
     "B1_in_set_goes_green",
     "ruling B's shape: naming a *_code field is enough, no contract consulted"),
]


def mutant_table():
    src = io.open(R7B4, encoding="utf-8").read()
    base = run(R7B4, TIP_PANEL, INLINE, "mut_base")
    base_block = run(R7B4, TIP_PANEL, REAL_CONTRACT, "mut_base_block")
    base_b7 = None
    rows = []
    for name, old, new, expect, why in MUTANTS:
        assert src.count(old) == 1, (name, src.count(old))
        tmp = os.path.join(JIA, "mutant_%s.cjs" % name.lower())
        io.open(tmp, "w", encoding="utf-8", newline="\n").write(src.replace(old, new, 1))
        got_inline = run(tmp, TIP_PANEL, INLINE, "mut_%s_inline" % name)
        got_block = run(tmp, TIP_PANEL, BLOCK, "mut_%s_block" % name)
        got_real = run(tmp, TIP_PANEL, REAL_CONTRACT, "mut_%s_real" % name)
        flips = []
        if got_inline["exempted"] != base["exempted"] or got_inline["cells"] != base["cells"]:
            flips.append("inline_arm_changed")
        if got_block["exempted"] or got_block["cells"] != base_block["cells"] \
                or [b["why"] for b in got_block["blocked"]] != [b["why"] for b in base_block["blocked"]]:
            flips.append("block_form_arm_changed" if got_block["exempted"] else "block_red_changed")
        if [b["why"] for b in got_real["blocked"]] != ["CONTRACT_MISSING_ENUM"] \
                or got_real["cells"] != base_block["cells"]:
            flips.append("missing_enum_red_changed")
        rows.append({"mutant": name, "edit": old.strip()[:70], "why_it_matters": why,
                     "expected_to_be_caught_by": expect, "flips": flips,
                     "caught": bool(flips),
                     "cells": {"inline": got_inline["cells"], "block": got_block["cells"],
                               "real": got_real["cells"]},
                     "exempted": {"inline": len(got_inline["exempted"]),
                                  "block": len(got_block["exempted"]),
                                  "real": len(got_real["exempted"])},
                     "blocked_why": {"inline": [b["why"] for b in got_inline["blocked"]],
                                     "block": [b["why"] for b in got_block["blocked"]],
                                     "real": [b["why"] for b in got_real["blocked"]]}})
        os.remove(tmp)
    uncaught = [r["mutant"] for r in rows if not r["caught"]]
    return rows, uncaught


def main():
    before, after, checks = arms_files()
    rows, uncaught = mutant_table()
    out = {"schema": "CNX_S4_ORD0408_ARMS_AND_MUTANTS_R1",
           "ruler": {"file": os.path.basename(R7B4), "blob": blob(R7B4),
                     "bytes": os.path.getsize(R7B4)},
           "arm_checks": [{"check": c, "pass": bool(ok)} for c, ok in checks],
           "all_arm_checks_pass": all(bool(ok) for _c, ok in checks),
           "mutants": rows, "uncaught_mutants": uncaught,
           "note": "each mutant is a defect this lineage actually had today; a mutant no arm flips "
                   "means the arm is decoration"}
    io.open(os.path.join(JIA, "arm_mutant_r7b4.json"), "w", encoding="utf-8", newline="\n").write(
        json.dumps(out, ensure_ascii=False, indent=1))
    print("arm checks:", sum(1 for c, ok in checks if ok), "/", len(checks))
    for c, ok in checks:
        if not ok:
            print("  FAILED", c)
    for r in rows:
        print("%-26s caught=%s flips=%s cells=%s" % (r["mutant"], r["caught"], r["flips"],
                                                     json.dumps(r["cells"], ensure_ascii=False)[:90]))
    print("uncaught:", uncaught)
    return 0 if (out["all_arm_checks_pass"] and not uncaught) else 1


if __name__ == "__main__":
    sys.exit(main())
