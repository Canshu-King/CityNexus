R7B4 = os.path.join(ROOT, "ui_exposure_taint_ast_r7b4.cjs")
TIP_PANEL = os.path.join(JIA, "tip", "frontend", "src", "features", "trash",
                         "JourneyTrashPanel.tsx")
REAL_CONTRACT = os.path.join(JIA, "tip", "contracts", "openapi.yaml")
INLINE = os.path.join(JIA, "openapi_inline_enum.yaml")
BLOCK = os.path.join(JIA, "openapi_block_enum.yaml")
ABSENT = os.path.join(JIA, "no_such_contract_at_all.yaml")


def run(ruler, target, contract, out_name):
    js = os.path.join(JIA, "split_%s.json" % out_name)
    cmd = ["node", ruler, "--file", target, "--out", js]
    if contract:
        cmd += ["--contract", contract]
    p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace",
                       timeout=900, env=dict(os.environ, HTTPS_PROXY="", HTTP_PROXY=""))
    d = json.load(io.open(js, encoding="utf-8"))
    return {"exit": p.returncode,
            "cells": sorted(h["rule"] + "@" + str(h["line"]) for h in d.get("hits", [])),
            "folded": sorted(e.get("file_line") for e in d.get("attributed_in_fold", [])),
            "exempted": [{"line": e["file_line"], "rule": e["rule"], "field": e.get("field"),
                          "basis": e.get("basis"), "tokens": e.get("tokens_seen"),
                          "contract": os.path.basename(e.get("contract") or ""),
                          "contract_line": e.get("contract_enum_line"),
                          "contract_form": (d.get("contract", {}).get("enum_forms") or {}).get(
                              e.get("field")),
                          "contract_blob": e.get("contract_blob")}
                         for e in d.get("contract_exempted", [])],
            "blocked": [{"line": b["file_line"], "rule": b["rule"], "field": b.get("field"),
                         "why": b.get("why"), "examples": b.get("examples"),
                         "contract": os.path.basename(b.get("contract") or "")}
                        for b in d.get("contract_blocked", [])]}


