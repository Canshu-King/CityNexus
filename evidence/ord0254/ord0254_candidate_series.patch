+async function inbox(page: Page, journeyId: string): Promise<{ drafts: Draft[] }> {
+  const response = await page.request.get(`/api/v1/journeys/${journeyId}/inbox`);
+  return (await response.json()) as { drafts: Draft[] };
+}
